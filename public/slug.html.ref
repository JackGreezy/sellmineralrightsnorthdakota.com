bad.webp" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/64c38ca9b1a2e59bd5b7d64a/64ff146dd19f854eca576e8c_E-175%20EP5_3%201-p-500.webp 500w, /assets-f/img/0266ea774cdbad.webp 640w" class="produkt-image-m"></div></div></div></div></div></section><section class="section-benefits green"><div class="padding-side normal"><div class="padding-top-bottom top-btm-120"><div class="w-layout-blockcontainer main-container w-container"><div class="section-headline-wrapper padd-side-normal mar-btm-80"><h2 class="h2 white">Our customer promise</h2></div><div class="cta-icon-grid-wrapper"><div class="w-layout-grid cta-icon-grid _6-colums"><div id="w-node-_828d97d5-1a80-1b4c-b639-c97874ba5830-972e3b37" class="cta-icon-content horizontal"><div class="cta-icon-wrapper"><img src="/assets-f/img/35323b4daa04b7.svg" loading="lazy" width="50" height="50" alt="" class="cta-icon"></div><div class="cta-icon-text-wrapper"><h3 class="h3 white">Quality</h3><p class="p1-large-regular gb-200">We deliver high-quality products and innovative solutions.</p></div></div><div id="w-node-_828d97d5-1a80-1b4c-b639-c97874ba5838-972e3b37" class="cta-icon-content horizontal"><div class="cta-icon-wrapper"><img src="/assets-f/img/0d1c92db4f675b.svg" loading="lazy" width="50" height="50" alt="" class="cta-icon"></div><div class="cta-icon-text-wrapper"><h3 class="h3 white">Partnering</h3><p class="p1-large-regular gb-200">We support you as partners throughout your project.</p></div></div><div id="w-node-_828d97d5-1a80-1b4c-b639-c97874ba5840-972e3b37" class="cta-icon-content horizontal"><div class="cta-icon-wrapper"><img src="/assets-f/img/dcd2f5cd0b7382.svg" loading="lazy" width="50" height="50" alt="" class="cta-icon"></div><div class="cta-icon-text-wrapper"><h3 class="h3 white">Reliability</h3><p class="p1-large-regular gb-200">We communicate transparently and are happy to be judged on our actions.</p></div></div><div id="w-node-_828d97d5-1a80-1b4c-b639-c97874ba5848-972e3b37" class="cta-icon-content horizontal"><div class="cta-icon-wrapper"><img src="/assets-f/img/265b72195c67ad.svg" loading="lazy" width="50" height="50" alt="" class="cta-icon"></div><div class="cta-icon-text-wrapper"><h3 class="h3 white">Flexibility</h3><p class="p1-large-regular gb-200">We stay agile and adapt to changing boundary conditions.</p></div></div><div id="w-node-_828d97d5-1a80-1b4c-b639-c97874ba5850-972e3b37" class="cta-icon-content horizontal"><div class="cta-icon-wrapper"><img src="/assets-f/img/c8398638268b8b.svg" loading="lazy" width="50" height="50" alt="" class="cta-icon"></div><div class="cta-icon-text-wrapper"><h3 class="h3 white">Responsibility</h3><p class="p1-large-regular gb-200">We assume responsibility for the tasks assigned to us.</p></div></div><div id="w-node-_828d97d5-1a80-1b4c-b639-c97874ba5858-972e3b37" class="cta-icon-content horizontal"><div class="cta-icon-wrapper"><img src="/assets-f/img/5da0505a83fa86.svg" loading="lazy" width="50" height="50" alt="" class="cta-icon"></div><div class="cta-icon-text-wrapper"><h3 class="h3 white">Respect</h3><p class="p1-large-regular gb-200">We treat one another with respect, as this is the basis for successful working relationships.</p></div></div></div></div></div></div></div></section><section class="portfolio"><div class="padding-side normal"><div class="padding-top-bottom top-120-btm-220"><div class="w-layout-blockcontainer main-container w-container"><div class="section-headline-wrapper padd-side-normal mar-btm-80"><h2 class="h2">Other ENERCON wind turbines</h2></div><div class="content-margin-btm btm-90px"><div class="collection-list-wrapper-9 w-dyn-list"><div role="list" class="collection-list-anlagenportfolio w-dyn-items"><div role="listitem" class="w-dyn-item"><div class="anlagen-wrapper-portfolio"><div class="anlagen-image-wrapper"><img src="/assets-f/img/bbdbaa3c99d334.jpg" loading="lazy" alt="" sizes="(max-width: 767px) 100vw, (max-width: 991px) 95vw, 800px" srcset="https://cdn.prod.website-files.com/64c38